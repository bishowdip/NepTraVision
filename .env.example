# Copy to `.env` and adjust. Loaded by neptravision.config when present.
# Nothing secret should ever be committed — .env is gitignored.

# Root for heavy data (override if you keep footage on an external drive).
NEPTRAVISION_DATA_ROOT=./data

# Root for experiment outputs (runs, weights, logs).
NEPTRAVISION_EXPERIMENTS_ROOT=./experiments

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
NEPTRAVISION_LOG_LEVEL=INFO

# Global random seed (per-experiment seeds override this).
NEPTRAVISION_SEED=42
